{
  "name": "support-mail-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "check": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:web": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "build": "npm run check && npm run build:web && npm run build:worker",
    "deploy": "npm run build:web && wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply MAIL_DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply MAIL_DB --remote"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^6.1.0",
    "postal-mime": "^2.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260717.1",
    "@types/node": "^25.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.6.3",
    "vite": "^8.1.4",
    "wrangler": "^4.0.0"
  }
}
